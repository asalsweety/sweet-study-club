# Public application URL used when creating share and invitation links.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Temporary legacy configuration while existing screens are migrated to the
# same-origin Cloudflare Worker API. Remove these variables with the final
# Supabase client dependency; never place a service-role key in Vite config.
