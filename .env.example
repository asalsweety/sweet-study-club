# Browser-safe values only: everything prefixed VITE_ is embedded in the
# public bundle. Worker secrets belong in .dev.vars (local) or Cloudflare
# encrypted secrets (remote), never here.

# Public application URL used when creating share and invitation links.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Optional. Leave empty for the web app, which calls same-origin /api.
VITE_API_BASE_URL=

# Set to true only after buying a fontiran.com website license for the
# Mahboubeh Mehravar title font; otherwise builds ship the free Lalezar.
VITE_TITLE_FONT_LICENSED=false
